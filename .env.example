# Reuse the existing JobScheduler DATABASE_URL or set MYSQL_DSN instead.
DATABASE_URL=mysql+pymysql://user:password@mysql:3306/job_scheduler
LISTEN_ADDR=:8000
AGENT_API_TOKEN=replace-with-existing-token
DISPATCH_ENABLED=true
REQUEST_TIMEOUT_SECONDS=10
HEALTH_ALERT_AFTER_SECONDS=180
LARK_WEBHOOK_URL=
# Optional: existing managed schedule integration.
TASK_SCHEDULER_SOURCE=
TASK_SCHEDULER_ENVIRONMENT=test
TASK_DELIVERY_URL=
TASK_DELIVERY_TOKEN=
